{
  "configVersion": 13,
  "_note": "Every size is a ratio of the measured icon (27x20 on this machine, so the basis is 27px). Absolute px knobs are interpreted at anchor.referencePx and scaled by basis/referencePx, so the look survives other DPIs / taskbar scales. Edit, save, and the overlay picks it up in ~2s.",
  "attention": {
    "minVisibleMs": 1500
  },
  "buttonMatch": {
    "automationId": ["com.deepseek.dsh", "electron.app.DeepSeek Harness"],
    "name": ["DeepSeek Harness"]
  },
  "anchor": {
    "mode": "taskbar-button",
    "target": "icon",
    "referencePx": 27,
    "iconScale": 0.5,
    "iconOffsetX": 0,
    "iconOffsetY": 0,
    "calibrate": true,
    "calibrateMinPx": 12,
    "calibrateMaxPx": 48,
    "calibrateMinRatio": 0.18,
    "calibrateMaxRatio": 0.72,
    "calibrateThreshold": 60,
    "iconPad": 1.0,
    "offsetX": 0,
    "offsetY": 0,
    "screenCorner": "bottom-right",
    "cornerMarginX": 12,
    "cornerMarginY": 12
  },
  "badge": {
    "enabled": true,
    "unreadOnly": true,
    "size": 0,
    "sizeRatio": 0.73,
    "lift": 0.5,
    "insetX": 0,
    "insetY": 3,
    "radius": 0.34,
    "bg": "#0d0d0d",
    "fg": "#ffffff",
    "ring": "#f5f5f5",
    "ringWidth": 1.2,
    "fontFamily": "Segoe UI",
    "fontSize": 0,
    "fontSizeRatio": 0.8,
    "textOffsetX": 0,
    "textOffsetY": 0,
    "fontBold": true,
    "hideWhenZero": true
  },
  "dots": {
    "size": 0,
    "sizeRatio": 0.56,
    "gap": 3,
    "start": "badge",
    "mode": "fit",
    "insetX": -3,
    "insetY": 2,
    "question": "#111111",
    "approval": "#ffc400",
    "error": "#ef4444",
    "ring": "#ffffff",
    "ringWidth": 1.2,
    "order": "kind",
    "group": "kind",
    "max": 2
  },
  "error": {
    "_note": "The red dot for a FAILED turn sits on the icon's top-left corner and never adds to the badge number. size=0 means 'same as dots.size'. insetX/insetY move its centre relative to that corner.",
    "size": 0,
    "insetX": 0,
    "insetY": 0
  },
  "clickThrough": true,
  "pollMs": 500,
  "buttonRefreshMs": 4000,
  "buttonSearchMs": 120000,
  "buttonRetryMs": 4000
}
