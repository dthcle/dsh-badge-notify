{
  "name": "dsh-badge-notify",
  "version": "0.6.0",
  "description": "ChatGPT-style notification overlay on the DSH taskbar button: a black/white badge whose centre sits on the icon's top-right corner with the number of UNREAD completed sessions (matching DSH's own green completion dot), plus a column of attention dots centred on the icon's left edge (black = question awaiting reply, yellow = permission request).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis-plugin",
    "taskbar",
    "badge",
    "notification",
    "windows"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "os": [
    "win32"
  ],
  "files": [
    "lib/**/*.js",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dthcle/dsh-badge-notify.git"
  },
  "homepage": "https://github.com/dthcle/dsh-badge-notify#readme",
  "bugs": {
    "url": "https://github.com/dthcle/dsh-badge-notify/issues"
  },
  "author": "dthcle"
}
